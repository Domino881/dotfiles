#!/usr/bin/env bash
sizes=(33% 50% 66%)
tmpfile=/tmp/cyclic_resize_idx
[ ! -f "${tmpfile}" ] && echo "0" > $tmpfile

cyclic_idx=$(cat $tmpfile)
((cyclic_idx=(cyclic_idx+1)%3))

echo $cyclic_idx > $tmpfile

echo "hyprctl dispatch resizeactive exact ${sizes[$cyclic_idx]} 100%"
hyprctl dispatch resizeactive exact "${sizes[$cyclic_idx]}" 100%
